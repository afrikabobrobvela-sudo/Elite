{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elite",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // La página (public/) se sirve como archivos estáticos; solo /api/* pasa por el Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elite",
      "database_id": "79aaf2a5-02e8-4bf3-9bfd-78d4847ee6c1",
      "migrations_dir": "migrations"
    }
  ]
  // Secretos (no van aquí): EDITOR_PASSWORD, VIEWER_PASSWORD, SESSION_SECRET.
  // En producción: `npx wrangler secret put <NOMBRE>`. En local: archivo .dev.vars.
}
